@inject PortfolioDataService DataService

<div class="section-header">
    <h2 class="mono-text section-title"><span class="accent-cyan">03.</span> Operations & Experience</h2>
    <div class="header-line"></div>
</div>

<div class="experience-container">
    <div class="experience-timeline">
        @foreach (var exp in DataService.GetExperience())
        {
            <div class="glass-card timeline-card">
                <div class="timeline-dot"></div>
                <div class="exp-header">
                    <div>
                        <h3 class="exp-role">@exp.Role</h3>
                        <div class="exp-company mono-text">@@ @exp.Company</div>
                    </div>
                    <div class="exp-meta text-right">
                        <div class="exp-dates mono-text">@exp.Dates</div>
                        <div class="exp-location text-muted">@exp.Location</div>
                    </div>
                </div>

                <ul class="exp-responsibilities">
                    @foreach (var resp in exp.Responsibilities)
                    {
                        <li><span class="bullet-arrow">-></span> @resp</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<style>
    .experience-container {
        position: relative;
        padding-left: 2rem;
    }

    .experience-container::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 1px;
        background: linear-gradient(180deg, var(--accent-purple), var(--border-color) 80%, transparent);
    }

    .experience-timeline {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .timeline-card {
        position: relative;
    }

    .timeline-dot {
        position: absolute;
        left: -3rem;
        top: 2rem;
        width: 15px;
        height: 15px;
        background: var(--bg-dark);
        border: 2px solid var(--accent-cyan);
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
    }

    .exp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }

    .exp-role {
        font-size: 1.5rem;
        color: var(--text-main);
        margin-bottom: 0.25rem;
    }

    .exp-company {
        color: var(--accent-cyan);
        font-size: 0.9rem;
    }

    .exp-meta {
        text-align: right;
    }

    .exp-dates {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    .text-muted {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .exp-responsibilities {
        list-style: none;
    }

    .exp-responsibilities li {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        color: var(--text-muted);
        line-height: 1.6;
    }
    
    @@media (max-width: 768px) {
        .exp-header {
            flex-direction: column;
            gap: 1rem;
        }
        .exp-meta {
            text-align: left;
        }
    }
</style>
